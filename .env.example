# Entorno: local | dev | test | prod
NODE_ENV=local

# Marca / plantilla
BOT_DISPLAY_NAME=Zycryx Bot
BOT_PACKAGE_NAME=Zycryx Stickers
BOT_AUTHOR=Zycryx
BOT_BANNER_NAME=ZYCRYX BOT
BOT_BANNER_AUTHOR=by: Zycryx
BOT_REPOSITORY_URL=
BOT_WEBSITE_URL=
BOT_YOUTUBE_URL=
BOT_TIKTOK_URL=
BOT_FACEBOOK_URL=
BOT_INSTAGRAM_URL=
BOT_GROUP_LINKS=
BOT_CHANNEL_LINKS=
BOT_MOD_GROUP_ID=
# Owners normales: numeros internacionales sin +, separados por coma.
# Ejemplo: BOT_OWNER_NUMBERS=573001112233,51999888777
BOT_OWNER_NUMBERS=
# Owners reales/root: numeros internacionales sin + o JIDs completos, separados por coma.
DEFAULT_MENU_IMAGE=./resources/media/menus/Menu2.jpg
LOG_LEVEL=command
PERF_LOG_THRESHOLD_MS=750
HTTP_TIMEOUT_MS=15000
DB_CACHE_TTL_MS=300000
AUDIO_CACHE_TTL_MS=300000
BACKGROUND_TASK_CONCURRENCY=4
PLUGIN_HOT_RELOAD_ENABLED=false
REQUIRED_PLUGIN_PATHS=hooks/_antilink,hooks/_antilink2,hooks/_antiprivado,hooks/_virustotal,hooks/_censored
MESSAGE_QUEUE_CONCURRENCY=32
MESSAGE_QUEUE_PER_CHAT_LIMIT=50
MESSAGE_QUEUE_GLOBAL_LIMIT=2000

# Sesiones Baileys: database (recomendado) | files (compatibilidad/migración)
BAILEYS_AUTH_STATE_SOURCE=database
# Las escrituras de Signal keys se agrupan fuera del camino crítico de mensajes.
BAILEYS_AUTH_WRITE_DELAY_MS=25
BAILEYS_AUTH_LEASE_SECONDS=120

# Cifrado de tokens y sesiones. Recomendado: clave aleatoria de 32 bytes en base64.
# Generar con: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BOT_SECRETS_KEY_VERSION=1
BOT_SECRETS_MASTER_KEY_B64=
# Rotación opcional: JSON version -> clave base64. Incluye todas las versiones aún en uso.
BOT_SECRETS_KEYRING_JSON=
# Alternativa: Argon2id deriva la clave una vez al arrancar. No configurar ambas opciones.
BOT_SECRETS_PASSPHRASE=
# Salt aleatorio de al menos 16 bytes en base64, obligatorio con passphrase.
BOT_SECRETS_KDF_SALT_B64=

# APIs externas
API_BASE_URL=https://api.delirius.store
API_KEY=
FGMODS_API_URL=https://api.fgmods.xyz/api
FGMODS_API_KEY=
NEOXR_API_URL=https://api.neoxr.eu/api
NEOXR_API_KEY=
ACR_HOST=identify-eu-west-1.acrcloud.com
ACR_ACCESS_KEY=
ACR_ACCESS_SECRET=
ALYACHAN_API_KEY=
BETABOTZ_API_KEY=
LOLHUMAN_API_KEY=
TENOR_API_KEY=
TELEGRAM_BOT_TOKEN=
SKYULTRA_API_KEY=
UNSPLASH_ACCESS_KEY=
ZENKEY_API_KEY=
TRANSLATE_API_KEY=
PERPLEXITY_API_KEYS=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_ENABLED=true
VIRUSTOTAL_MAX_FILE_MB=32
VIRUSTOTAL_POLL_ATTEMPTS=6
VIRUSTOTAL_POLL_INTERVAL_MS=10000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zycryx_bot
DB_USER=postgres
DB_PASSWORD=
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=30000
HEALTH_HOST=127.0.0.1
HEALTH_METRICS_TOKEN=
HEALTH_PORT=3000
CONSOLE_VIEW_TOKEN=
# Sólo para `npm run db:setup-runtime-role`; no usar esta URL administrativa al ejecutar el bot.
DB_ADMIN_URL=
DB_RUNTIME_ROLE=zycryx_bot_app
DB_RUNTIME_PASSWORD=
# Alternativa: usar DATABASE_URL en lugar de los parámetros individuales
# DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db
