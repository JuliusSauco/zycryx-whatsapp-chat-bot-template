{
  "name": "zycryx-whatsapp-chat-bot-template",
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true});\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:helpers && npm run test:contact-user-sync && npm run test:censored && npm run test:rpg-admin-add && npm run test:robbery && npm run test:autolevelup && npm run test:plugin-pipeline && npm run test:command-resources && npm run test:profile-user && npm run test:user-domain && npm run test:group-domain && npm run test:family-access && npm run test:subbot-domain && npm run test:audio-domain && npm run test:operations-domain && npm run test:character-domain && npm run test:ephemeral && npm run test:router && npm run test:guards && npm run test:context && npm run test:services && npm run test:security && npm run test:providers && npm run test:ai-providers && npm run test:media-conversion && npm run test:catalog && npm run test:catalog-audit && npm run test:help && npm run test:p0",
    "test:helpers": "tsx tests/helpers.test.ts",
    "test:contact-user-sync": "tsx tests/contact-user-sync.test.ts",
    "test:censored": "tsx tests/censored-users.test.ts",
    "test:rpg-admin-add": "tsx tests/rpg-admin-add.test.ts",
    "test:robbery": "tsx tests/robbery-domain.test.ts",
    "test:autolevelup": "tsx tests/autolevelup.test.ts",
    "test:plugin-pipeline": "tsx tests/plugin-pipeline.test.ts",
    "test:command-resources": "tsx tests/command-resources.test.ts",
    "test:profile-user": "tsx tests/profile-user.test.ts",
    "test:user-domain": "tsx tests/user-domain.test.ts",
    "test:group-domain": "tsx tests/group-domain.test.ts",
    "test:family-access": "tsx tests/family-access.test.ts",
    "test:subbot-domain": "tsx tests/subbot-domain.test.ts",
    "test:audio-domain": "tsx tests/audio-domain.test.ts",
    "test:operations-domain": "tsx tests/operations-domain.test.ts",
    "test:character-domain": "tsx tests/character-domain.test.ts",
    "test:ephemeral": "tsx tests/ephemeral-state.test.ts",
    "test:router": "tsx tests/router.test.ts",
    "test:guards": "tsx tests/guards.test.ts",
    "test:context": "tsx tests/context-builder.test.ts",
    "test:services": "tsx tests/services.test.ts",
    "test:security": "tsx tests/sensitive-command.test.ts",
    "test:providers": "tsx tests/download-providers.test.ts",
    "test:ai-providers": "tsx tests/ai-providers.test.ts",
    "test:media-conversion": "tsx tests/media-conversion-providers.test.ts",
    "test:catalog": "tsx tests/command-catalog.test.ts",
    "test:catalog-audit": "tsx tests/command-catalog-audit.test.ts",
    "test:help": "tsx tests/command-help.test.ts",
    "test:p0": "tsx tests/p0-architecture.test.ts",
    "ops:check": "tsx scripts/ops-check.ts",
    "ops:backup": "tsx scripts/ops-backup.ts",
    "ops:backup:db": "tsx scripts/ops-backup.ts --db-only",
    "ops:backup:sessions": "tsx scripts/ops-backup.ts --sessions-only",
    "db:generate": "drizzle-kit generate",
    "db:ensure-schema": "tsx src/db/ensure-schema.ts",
    "db:migrate": "npm run db:ensure-schema && drizzle-kit migrate",
    "db:setup": "npm run db:migrate",
    "db:studio": "drizzle-kit studio",
    "dev": "cross-env NODE_ENV=local tsx watch src/core/index.ts",
    "dev:dev": "cross-env NODE_ENV=dev tsx watch src/core/index.ts",
    "dev:test": "cross-env NODE_ENV=test tsx watch src/core/index.ts",
    "postinstall": "tsc",
    "serve": "cross-env NODE_ENV=prod node --max-old-space-size=512 dist/core/index.js",
    "serve:local": "cross-env NODE_ENV=local node --max-old-space-size=512 dist/core/index.js",
    "serve:dev": "cross-env NODE_ENV=dev node --max-old-space-size=512 dist/core/index.js",
    "serve:test": "cross-env NODE_ENV=test node --max-old-space-size=512 dist/core/index.js",
    "serve:migrate": "npm run db:migrate && npm run serve",
    "serve:local:migrate": "npm run db:migrate && npm run serve:local",
    "serve:dev:migrate": "npm run db:migrate && npm run serve:dev",
    "serve:test:migrate": "npm run db:migrate && npm run serve:test",
    "start": "npm run build && npm run serve",
    "start:local": "npm run build && npm run serve:local",
    "start:dev": "npm run build && npm run serve:dev",
    "start:test": "npm run build && npm run serve:test",
    "start:migrate": "npm run build && npm run db:migrate && npm run serve",
    "start:local:migrate": "npm run build && npm run db:migrate && npm run serve:local",
    "start:dev:migrate": "npm run build && npm run db:migrate && npm run serve:dev",
    "start:test:migrate": "npm run build && npm run db:migrate && npm run serve:test",
    "bun:start": "cross-env NODE_ENV=prod bun run src/core/index.ts",
    "bun:start:dev": "cross-env NODE_ENV=dev bun run src/core/index.ts",
    "bun:start:local": "cross-env NODE_ENV=local bun run src/core/index.ts"
  },
  "dependencies": {
    "@bochilteam/scraper": "^5.0.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "acrcloud": "^1.4.0",
    "api-dylux": "^1.8.3",
    "axios": "^1.18.1",
    "axios-cookiejar-support": "^5.0.5",
    "cfonts": "^3.3.0",
    "chalk": "^5.3.0",
    "cheerio": "1.0.0-rc.12",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "file-type": "^18.0.0",
    "fluent-ffmpeg": "^2.1.2",
    "form-data": "^4.0.6",
    "formdata-node": "^5.0.0",
    "fuzzysort": "^1.0.0",
    "hispamemes": "^1.0.7",
    "human-readable": "^0.2.1",
    "jimp": "^1.6.0",
    "link-preview-js": "^3.0.0",
    "lodash": "^4.17.21",
    "mime-types": "^2.1.35",
    "node-cache": "^5.1.2",
    "node-fetch": "^3.2.10",
    "node-gtts": "^2.0.2",
    "node-webpmux": "^3.1.3",
    "openai": "^3.3.0",
    "pino": "^8.0.0",
    "qrcode": "^1.5.0",
    "qrcode-terminal": "^0.12.0",
    "readline-sync": "^1.4.10",
    "sharp": "0.35.0",
    "syntax-error": "^1.4.0",
    "url-file-size": "^1.0.5-1",
    "yargs": "^17.7.3",
    "yt-search": "^2.12.1",
    "ytdl-core": "^4.11.5"
  },
  "optionalDependencies": {
    "moment-timezone": "^0.5.37",
    "pg": "^8.22.0",
    "wa-sticker-formatter": "^4.4.4"
  },
  "overrides": {
    "sharp": "0.35.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.18.0",
    "@types/yargs": "^17.0.35",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
